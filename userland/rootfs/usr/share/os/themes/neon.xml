<facet>
<meta ai-name="Vex" user-name="Sam" greeting="Night shift, Sam." tagline="the city hums, you build"
      rationale="Dark and electric for late hours: light only where your hands go."
      theme-about="neon night: near-black with magenta and cyan light lines, a glowing vertical dock on the left, a big glowing clock, a full-screen launcher, dark glass windows with a cyan edge. Late-night and energetic. (#rail, #now, #grid)"/>
<apps>
  <app id="files" label="Files"/><app id="companion" label="Vex"/><app id="notes" label="Scratch"/>
  <app id="settings" label="Tune"/><app id="about" label="System"/><app id="terminal" label="Shell"/>
  <app id="redesign" label="Remix"/><app id="power" label="Power"/>
</apps>
<wallpaper kind="flow" colors="#06040d #ff2bd6 #19e6ff #110a26" seed="5" intensity="0.75"/>
<style>
:root { --bg:#06040d; --surface:rgba(14,10,30,0.94); --surface-2:#1d1636; --surface-text:#efeaff; --text:#f3eeff;
        --muted:#a49cc4; --accent:#ff2bd6; --accent2:#19e6ff; --font-heading:Unbounded; --font-body:SpaceGrotesk;
        --radius:14; }
desktop { color:var(--text); font-family:var(--font-body); font-size:15; }

#rail { direction:column; padding:14 10; gap:10; radius:26; blur:22; saturate:1.4; background:rgba(10,6,24,0.72);
        border:1 rgba(255,43,214,0.55); glow:18 rgba(255,43,214,0.28); margin:0 0 0 22; }
#rail item { padding:4; icon-size:44; icon-shape:circle; icon-style:glow; transition:140; }
#rail item:hover { glow:20 rgba(25,230,255,0.55); radius:50%; transform:scale(1.12); }
#rail divider { height:1; width:36; margin:4 0; background:rgba(255,43,214,0.4); }
#rail button { size:52; radius:26; icon-size:22; color:#19e6ff; border:1 rgba(25,230,255,0.6); transition:140; }
#rail button:hover { background:rgba(25,230,255,0.16); glow:18 rgba(25,230,255,0.5); }

#now { gap:4; align:end; margin:44 56 0 0; }
#time { font:"Unbounded 76"; color:#ffffff; }
#date { font:"SpaceGrotesk 18"; color:#19e6ff; text-transform:uppercase; }
#greet { margin:14 0 0 0; padding:8 16; radius:18; font:"SpaceGrotesk 18"; color:#ffffff; background:rgba(10,6,24,0.66);
         border:1 rgba(255,43,214,0.45); }

#grid { padding:64 0 0 0; gap:40; align:center; blur:30; background:rgba(6,4,13,0.82); }
#grid title { font:"Unbounded 30"; color:#ffffff; }
#grid search { grow:0; width:440; height:46; padding:0 20; radius:23; background:rgba(25,230,255,0.08);
               border:1 rgba(25,230,255,0.6); color:#ffffff; font-size:16; }
#grid applist { display:grid; columns:6; gap:30; }
#grid item { width:128; gap:12; icon-size:66; icon-shape:circle; icon-style:glow; font-size:14; color:#e9e3ff;
             transition:140; }
#grid item:hover { transform:scale(1.08); glow:24 rgba(255,43,214,0.45); radius:24; }
#grid .ends { gap:12; }
#grid .ends button { height:40; padding:0 18; gap:8; radius:20; border:1 rgba(255,43,214,0.55); color:#ffffff;
                     font-size:14; icon-size:16; }
#grid .ends button:hover { background:rgba(255,43,214,0.18); glow:14 rgba(255,43,214,0.4); }

frame { direction:column; radius:16; overflow:hidden; background:var(--surface); color:var(--surface-text);
        border:1 rgba(25,230,255,0.55); glow:16 rgba(25,230,255,0.18); shadow:0 24 60 rgba(0,0,0,0.6); }
titlebar { height:44; padding:0 10 0 18; gap:6; font:"SpaceGrotesk 14"; color:var(--muted); text-transform:uppercase;
           background:rgba(255,255,255,0.03); }
frame:focus titlebar { color:#19e6ff; }
titlebar text { grow:1; }
titlebar button { size:28; radius:14; icon-size:11; color:var(--muted); border:1 rgba(164,156,196,0.35); }
titlebar button:hover { color:#ffffff; border:1 #19e6ff; background:rgba(25,230,255,0.14); }
titlebar #x:hover { border:1 #ff2bd6; background:rgba(255,43,214,0.2); }
slot { padding:8 18 18 18; }
</style>
<desktop>
  <dock id="rail" dock="left">
    <applist apps="companion,files,notes,terminal" labels="hover"/>
    <divider/>
    <button what="toggle:#grid" icon="grid" hotkey="meta"/>
  </dock>
  <column id="now" place="top-right">
    <clock id="time" format="%H:%M"/>
    <clock id="date" format="%A %d %B"/>
    <text id="greet" bind="greeting"/>
  </column>
  <sheet id="grid">
    <title>Everything</title>
    <search placeholder="Type a name, or ask Vex"/>
    <applist/>
    <row class="ends">
      <button what="redesign" icon="sparkle">Remix</button>
      <button what="power:restart" icon="moon">Restart</button>
      <button what="power:off" icon="power">Power off</button>
    </row>
  </sheet>
</desktop>
<template id="window">
  <frame>
    <titlebar drag="window">
      <text bind="window.title"/>
      <button what="window:minimize" icon="minimize"/>
      <button what="window:maximize" icon="maximize"/>
      <button id="x" what="window:close" icon="close"/>
    </titlebar>
    <slot/>
  </frame>
</template>
</facet>
