<facet>
<meta ai-name="Ember" user-name="Sam" greeting="Hello again, Sam." tagline="light through ice"
      rationale="Everything gathers around the one you talk to, like moons around a small cold star."
      theme-about="frost orbit: a dark aurora sky, the companion's orb glowing at the centre of the screen with the apps circling it on a ring, a thin clock and greeting above, frosted glass windows with pale cyan edges. Calm, celestial, centred. (#core, #ring, #sky)"/>
<apps>
  <app id="files" label="Files"/><app id="companion" label="Ember"/><app id="notes" label="Notes"/>
  <app id="settings" label="Settings"/><app id="about" label="About"/><app id="terminal" label="Terminal"/>
  <app id="redesign" label="Reshape"/><app id="power" label="Sleep"/>
</apps>
<wallpaper kind="aurora" colors="#070b1f #5fd3ff #9d7bff #0a1236" seed="9" intensity="0.85"/>
<style>
:root { --bg:#070b1f; --surface:rgba(16,24,52,0.86); --surface-2:rgba(255,255,255,0.08); --surface-text:#eaf4ff;
        --text:#eef6ff; --muted:#a9bddb; --accent:#5fd3ff; --accent2:#9d7bff; --font-heading:Sora; --font-body:Sora; --radius:18; }
desktop { color:var(--text); font-family:var(--font-body); font-size:15; }
#sky { gap:4; align:center; margin:46 0 0 0; }
#sky clock { font:"Sora 30"; color:#ffffff; letter-spacing:0.12em; }
#sky text { font-size:15; color:var(--muted); }
#core { display:stack; size:620; align:center; justify:center; }
#ring { display:orbit; orbit:230; }
#ring item { padding:6; gap:8; icon-size:54; icon-shape:circle; icon-style:glow; font-size:14; color:#ffffff; text-shadow:0 1 6 rgba(0,0,20,0.9); transition:160; }
#ring item label { padding:2 8; radius:10; background:rgba(6,10,30,0.6); }
#ring item:hover { transform:scale(1.14); glow:22 rgba(95,211,255,0.5); radius:48; }
#heart { size:150; }
#all { width:440; padding:18; gap:12; radius:22; blur:30; background:rgba(12,18,44,0.82); border:1 rgba(95,211,255,0.35); }
#all search { grow:0; height:40; padding:0 16; radius:20; background:rgba(255,255,255,0.08); color:#ffffff; }
#all applist { display:grid; columns:3; gap:8; }
#all item { padding:10; gap:8; radius:14; icon-size:36; icon-shape:circle; icon-style:glow; font-size:13; color:#eaf4ff; }
#all item:hover { background:rgba(95,211,255,0.14); }
#corner { margin:0 30 28 0; gap:8; }
#corner button { size:44; radius:22; icon-size:18; color:#cfe8ff; border:1 rgba(95,211,255,0.4); background:rgba(10,16,40,0.5); }
#corner button:hover { background:rgba(95,211,255,0.18); }
frame { direction:column; radius:20; overflow:hidden; background:var(--surface); color:var(--surface-text); blur:26;
        border:1 rgba(180,230,255,0.35); shadow:0 30 70 rgba(0,0,20,0.6); }
titlebar { height:46; padding:0 10 0 20; gap:6; font:"Sora 14"; color:var(--muted); }
frame:focus titlebar { color:#ffffff; }
titlebar text { grow:1; }
titlebar button { size:28; radius:14; icon-size:11; color:var(--muted); }
titlebar button:hover { background:rgba(95,211,255,0.2); color:#ffffff; }
slot { padding:4 18 18 18; }
</style>
<desktop>
  <column id="sky" place="top">
    <clock format="%H:%M"/>
    <text bind="greeting"/>
  </column>
  <stack id="core" place="center">
    <orb id="heart"/>
    <applist id="ring" apps="files,notes,terminal,settings,about,prism" labels="below"/>
  </stack>
  <row id="corner" place="bottom-right">
    <button what="toggle:#all" icon="search" hotkey="meta"/>
    <button what="power:off" icon="moon"/>
  </row>
  <popover id="all" placement="above" align="end">
    <search placeholder="Find anything, or ask Ember"/>
    <applist/>
  </popover>
</desktop>
<template id="window">
  <frame>
    <titlebar drag="window">
      <text bind="window.title"/>
      <button what="window:minimize" icon="minimize"/>
      <button what="window:maximize" icon="maximize"/>
      <button what="window:close" icon="close"/>
    </titlebar>
    <slot/>
  </frame>
</template>
</facet>
