<facet>
<meta ai-name="Wren" user-name="Sam" greeting="Morning, Sam. Nothing urgent." tagline="one thing at a time"
      rationale="Almost nothing on the screen: the time, a kind word, and the few things you use, written as words."
      theme-about="calm typographic: warm stone light, a huge quiet clock and greeting at the left, the apps as a short column of plain words beneath it (no icons, no bar, no dock), a white card for everything else, roomy white windows. Restful and literary. (#hello, #words, #all)"/>
<apps>
  <app id="files" label="Files"/><app id="companion" label="Wren"/><app id="notes" label="Notes"/>
  <app id="settings" label="Settings"/><app id="about" label="About"/><app id="terminal" label="Terminal"/>
  <app id="redesign" label="Rearrange"/><app id="power" label="Rest"/>
</apps>
<wallpaper kind="gradient" colors="#ebe6de #f5f2ec #e2dcd2 #d6cfc3" seed="2" intensity="0.35"/>
<style>
:root { --bg:#ebe6de; --surface:#fdfcfa; --surface-2:#f3f0ea; --surface-text:#2a2825; --text:#2a2825;
        --muted:#5f5b54; --accent:#4f7a68; --accent2:#c98b6b; --font-heading:Outfit; --font-body:Inter; --radius:16; }
desktop { color:var(--text); font-family:var(--font-body); font-size:15; }
#hello { gap:6; margin:88 0 0 112; align:start; }
#time { font:"Outfit 132"; color:var(--text); line-height:1; }
#date { font:"Outfit 22"; color:var(--muted); }
#greet { margin:26 0 0 0; font:"Outfit 26"; color:var(--text); }
#words { margin:40 0 0 0; gap:2; align:start; direction:column; }
#words applist { direction:column; align:start; gap:2; }
#words item { padding:4 0; font:"Outfit 30"; color:var(--muted); transition:160; }
#words item icon { display:none; }
#words item:hover { color:var(--accent); transform:translate(10, 0); }
#more { padding:4 0; font:"Outfit 30"; color:#8a5a40; transition:160; }
#more:hover, #more:open { color:var(--accent); transform:translate(10, 0); }
#all { width:420; padding:20; gap:14; radius:22; background:var(--surface); color:var(--surface-text);
       border:1 rgba(42,40,37,0.08); shadow:0 24 60 rgba(70,55,35,0.22); }
#all title { font:"Outfit 22"; color:var(--surface-text); padding:0 6; }
#all search { grow:0; height:42; padding:0 16; radius:21; background:var(--surface-2); color:var(--surface-text); font-size:15; }
#all applist { display:grid; columns:2; gap:4; align:stretch; }
#all item { direction:row; justify:start; gap:12; padding:8 10; radius:12; icon-size:26; icon-shape:none; icon-style:line;
            font-size:15; color:var(--surface-text); transition:100; }
#all item:hover { background:var(--surface-2); }
#all .quiet { gap:8; justify:end; }
#all .quiet button { height:34; padding:0 14; gap:8; radius:17; font-size:14; color:var(--muted); icon-size:16; }
#all .quiet button:hover { background:var(--surface-2); color:var(--surface-text); }
frame { direction:column; radius:18; overflow:hidden; background:var(--surface); color:var(--surface-text);
        border:1 rgba(42,40,37,0.08); shadow:0 24 64 rgba(70,55,35,0.2); }
titlebar { height:52; padding:0 12 0 24; gap:4; font:"Outfit 17"; color:var(--muted); }
frame:focus titlebar { color:var(--surface-text); }
titlebar text { grow:1; }
titlebar button { size:32; radius:16; icon-size:12; color:var(--muted); }
titlebar button:hover { background:var(--surface-2); color:var(--surface-text); }
slot { padding:4 24 24 24; }
</style>
<desktop>
  <column id="hello" place="top-left">
    <clock id="time" format="%H:%M"/>
    <clock id="date" format="%A, %d %B"/>
    <text id="greet" bind="greeting"/>
    <column id="words">
      <applist apps="companion,notes,files" labels="below"/>
      <button id="more" what="toggle:#all" hotkey="meta">everything else</button>
    </column>
  </column>
  <popover id="all" placement="right" align="end" anchor="#more">
    <title>Everything</title>
    <search placeholder="Find or ask"/>
    <applist labels="right"/>
    <row class="quiet">
      <button what="redesign" icon="sparkle">Rearrange</button>
      <button what="power:off" icon="power">Rest</button>
    </row>
  </popover>
</desktop>
<template id="window">
  <frame>
    <titlebar drag="window">
      <text bind="window.title"/>
      <button what="window:minimize" icon="minimize"/>
      <button what="window:maximize" icon="maximize"/>
      <button what="window:close" icon="close"/>
    </titlebar>
    <slot/>
  </frame>
</template>
</facet>
