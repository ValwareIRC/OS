<facet>
<meta ai-name="Wren" user-name="Ana" greeting="Morning, Ana." tagline="slow mornings" rationale="Warm paper and ink, because you write before you do anything else. At night it turns to lamplight."/>
<apps><app id="files" label="Folders"/><app id="companion" label="Wren"/><app id="notes" label="Pages"/><app id="settings" label="Tweaks"/><app id="about" label="This computer"/><app id="terminal" label="Console"/><app id="redesign" label="New look"/><app id="power" label="Turn off"/></apps>
<wallpaper kind="paper" colors="#f3ece0 #e6d8c3 #c9a882 #8a6a4a" seed="3" intensity="0.6"/>
<style>
:root { --bg:#f3ece0; --surface:#fbf8f2; --surface-text:#2b2520; --text:#2b2520; --muted:#7a6e62; --accent:#b4532a; --accent2:#3f6b5c; --font-heading:Fraunces; --font-body:Lora; --radius:10; }
@dark {
  :root { --bg:#1c1814; --surface:#26211c; --surface-text:#efe6d8; --text:#efe6d8; --muted:#a8998a; --accent:#e08a5a; --accent2:#7fb39f; }
  dock { background:rgba(38,33,28,0.92); border:1 rgba(255,240,220,0.12); }
}
dock { padding:8 14; gap:10; radius:18; background:rgba(251,248,242,0.92); border:1 rgba(60,40,20,0.12); shadow:0 10 30 rgba(60,40,20,0.18); margin:0 0 16 0; align:center; }
dock item { padding:2; icon-size:44; icon-shape:circle; icon-style:line; transition:140; }
dock item:hover { transform:translate(0,-6); }
dock orb { size:40; }
dock divider { width:1; height:36; margin:0 4; }
frame { direction:column; radius:12; background:var(--surface); border:1 rgba(60,40,20,0.14); shadow:0 18 50 rgba(60,40,20,0.22); overflow:hidden; color:var(--surface-text); }
titlebar { height:38; padding:0 12; gap:8; font:"Lora 14"; color:var(--muted); }
titlebar text { grow:1; }
titlebar button { size:22; radius:50%; icon-size:10; color:var(--muted); }
titlebar button:hover { background:rgba(120,90,60,0.14); }
slot { padding:6 22 22 22; }
#date { font:"Fraunces 22"; color:var(--text); margin:28 0 0 36; }
</style>
<desktop>
  <clock id="date" place="top-left" format="%A, %d %B"/>
  <dock dock="bottom"><applist apps="files,notes,terminal,settings,about,companion" labels="hover"/><divider/><orb/><button what="theme:toggle" icon="moon"/></dock>
</desktop>
<template id="window"><frame><titlebar drag="window"><text bind="window.title"/><button what="window:minimize" icon="minimize"/><button what="window:close" icon="close"/></titlebar><slot/></frame></template>
</facet>
