<facet>
<meta ai-name="Wren" user-name="Ana" greeting="Morning, Ana. Coffee first?" tagline="slow mornings" rationale="A sunny bar you know by heart, with your things one click away."/>
<apps><app id="files" label="Folders"/><app id="companion" label="Wren"/><app id="notes" label="Jotter"/><app id="settings" label="Tweaks"/><app id="about" label="This PC"/><app id="redesign" label="New look"/><app id="power" label="Turn off"/></apps>
<wallpaper kind="dunes" colors="#1d3b6e #f2a65a #ffd6a5 #0b1a33" seed="4" intensity="0.8"/>
<style>
:root { --bg:#0b1a33; --surface:#f7f1e8; --text:#ffffff; --surface-text:#1c2333; --muted:#6b7385; --accent:#2f6fd6; --accent2:#f2a65a; --font-heading:Manrope; --font-body:Inter; --radius:8; }
taskbar { height:48; padding:0 0 0 0; gap:6; background:linear-gradient(180deg,#3b7be0,#1d4fb0); shadow:0 -2 12 rgba(0,0,0,0.35); }
#start { padding:0 22 0 14; height:48; radius:0 22 22 0; background:linear-gradient(180deg,#5cc35c,#2f8f2f); color:#fff; font:"Manrope 18"; gap:8; icon-size:20; transition:120; }
#start:hover { background:linear-gradient(180deg,#6fd46f,#3aa23a); }
#start:open { background:linear-gradient(180deg,#2f8f2f,#237023); }
windowlist { gap:4; }
windowlist item { height:36; padding:0 12; radius:4; background:rgba(255,255,255,0.12); color:#fff; icon-size:18; max-width:200; }
windowlist item:open { background:rgba(255,255,255,0.3); }
#tray { padding:0 16; height:48; gap:10; background:rgba(0,0,30,0.25); color:#fff; font-size:14; border:1 rgba(255,255,255,0.15); }
#startmenu { width:420; background:var(--surface); radius:10 10 0 0; shadow:0 12 40 rgba(0,0,0,0.5); direction:column; overflow:hidden; color:var(--surface-text); }
#who { padding:14 18; gap:12; background:linear-gradient(180deg,#3b7be0,#2a5fc4); color:#fff; font:"Manrope 20"; icon-size:40; icon-shape:circle; align:center; }
#startmenu applist { direction:column; align:stretch; gap:2; padding:10; }
#startmenu item { direction:row; gap:12; padding:8 12; radius:6; icon-size:30; icon-shape:squircle; }
#startmenu item:hover { background:#2f6fd6; color:#fff; }
#foot { justify:end; gap:8; padding:10 14; background:#e9e1d4; }
#foot button { padding:6 14; radius:6; gap:6; icon-size:16; }
#foot button:hover { background:rgba(0,0,0,0.08); }
#greeting { direction:column; align:end; margin:40 48 0 0; gap:4; color:#fff; }
#greeting text { font:"Manrope 30"; }
frame { direction:column; background:var(--surface); radius:8 8 4 4; border:1 #1d4fb0; shadow:0 10 30 rgba(0,0,0,0.4); overflow:hidden; color:var(--surface-text); }
titlebar { height:34; padding:0 6 0 12; gap:6; background:linear-gradient(180deg,#8fb3ee,#6f95d8); color:#fff; font:"Manrope 15"; }
frame:focus titlebar { background:linear-gradient(180deg,#3b7be0,#1d4fb0); }
titlebar button { size:24; radius:4; background:rgba(255,255,255,0.22); icon-size:12; color:#fff; }
titlebar #x { background:#d9573f; }
titlebar #x:hover { background:#f06a50; }
slot { padding:12 18 18 18; }
</style>
<desktop>
  <taskbar dock="bottom" width="full">
    <button id="start" icon="grid" what="toggle:#startmenu" hotkey="meta">start</button>
    <windowlist/><spacer/>
    <row id="tray"><network/><volume show="label"/><notifications/><clock format="time12"/></row>
  </taskbar>
  <column id="greeting" place="top-right"><text bind="greeting"/><clock format="date"/></column>
  <popover id="startmenu" placement="above" align="start">
    <row id="who"><icon name="companion"/><text bind="user.name"/></row>
    <applist apps="files,companion,notes,settings,about" labels="below"/>
    <row id="foot"><button what="redesign" icon="sparkle">New look</button><button what="power:off" icon="power">Turn off</button></row>
  </popover>
</desktop>
<template id="window"><frame>
  <titlebar drag="window"><text bind="window.title" style="grow:1"/><button what="window:minimize" icon="minimize"/><button what="window:maximize" icon="maximize"/><button id="x" what="window:close" icon="close"/></titlebar>
  <slot/>
</frame></template>
</facet>
