app Mistakes
  data notes = files("~/Notes")
  state
    query = ""
    count = 0
  end
  derived
    shown = filter(notes, n -> contains(n.name, query) && n.size > 0)
    total = len(notes) + 1
    bad = fs.read("~/x")
  end
  fn save()
    count = count + 1
    set total = 3
    fs.writ("~/a", "b")
    after("save", 1000, save())
    let query = "x"
    if count == 1 or count == 2 and query != "" then
      return
    end
  end
  view
    <column>
      <input id="search" bind="qeury" width={200}/>
      <each in={shown} as="n">
        <buton on:click="sav(n)">{n.name}</buton>
      </each>
      <if test={count == 0}>
        <text>none</text>
      </if>
    </column>
  end
  style
    #search { font-size: 14; background: #ff0000; color: token(accnt); }
  end
end
