# Stopwatch: start, time runs with the clock, laps newest first, stop holds, reset only when stopped
expect "00:00.00"
click #go
expect "Stop"
tick 1500
expect "00:01.50"
click #lap
expect "Lap 1"
tick 61000
expect "01:02.50"
click #lap
click #go
expect "Start"
tick 5000
expect "01:02.50"
click #reset
expect "00:00.00"
expectnot "Lap 1"
